# Weather What To-Do — Environment Configuration

# Gemini API Key (Server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth Integration (Calendar, Tasks, & Sign-in)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Deployment Host / Site URL (Optional, default is same-origin)
NEXT_PUBLIC_APP_URL=https://weatherwhattodo.netlify.app
NEXT_PUBLIC_SITE_URL=https://weatherwhattodo.netlify.app
