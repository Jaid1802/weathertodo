# Weather What To-Do — Environment Configuration

# Gemini API Key (Server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Integration (Calendar & Tasks)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Deployment Host (Optional, default is same-origin)
NEXT_PUBLIC_APP_URL=https://weather-what-todo.netlify.app

