# Weather What To-Do — Environment Configuration
# ==============================================================================
# PUBLIC CLIENT VARIABLES (Safely bundled into Android APK & Web App via EXPO_PUBLIC_)
# ==============================================================================

# Supabase Authentication & Realtime
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth Integration (Client IDs for Public Authorization Request)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend Proxy / API URL (where Google token exchange and AI proxy run)
EXPO_PUBLIC_BACKEND_URL=https://weatherwhattodo-backend.onrender.com

# Deployment Host / Site Origin
EXPO_PUBLIC_SITE_URL=https://weatherwhattodo.netlify.app
NEXT_PUBLIC_SITE_URL=https://weatherwhattodo.netlify.app
NEXT_PUBLIC_APP_URL=https://weatherwhattodo.netlify.app

# Web Push Notification Public Key
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ==============================================================================
# SECRET SERVER-ONLY VARIABLES (NEVER BUNDLED INTO APK OR EXPOSED TO CLIENT)
# Configure these ONLY in backend server environments (Render / Node.js backend)
# ==============================================================================

# Gemini API Key (Server-side AI recommendations proxy)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client Secret (Exchanged securely only by backend server)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_WEB_CLIENT_SECRET=your_google_client_secret_here

# Supabase Service Role Key (Server administration only — NEVER client)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Push Private Key (Server push dispatch only)
VAPID_PRIVATE_KEY=your_vapid_private_key_here

